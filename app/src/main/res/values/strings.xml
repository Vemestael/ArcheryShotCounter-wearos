    <string name="series_title">Series</string>
    <string name="history_series_size">%1$d/end</string>
    <string name="series_off">Off</string>
    <string name="info_series_body">Groups your shots into ends of this size. The counter shows progress within the current end, and a new one starts automatically once it\'s full. Set to Off to just count shots with no grouping.</string>
    <string name="auto_pause_title">Auto-pause</string>
    <string name="auto_pause_on">Auto-pause: On</string>
    <string name="auto_pause_off">Auto-pause: Off</string>
    <string name="info_auto_pause_body">Automatically pauses shot detection for a while once you finish an end, so walking to the target or handling arrows doesn\'t get counted as shots. Resume early anytime with the pause button.</string>
    <string name="pause_duration_title">Pause duration</string>

    <string name="power_saving_title">Energy efficiency</string>
    <string name="power_saving_on">Energy efficiency: On</string>
    <string name="power_saving_off">Energy efficiency: Off</string>
    <string name="info_power_saving_body">Keeps the screen on during a session instead of letting it sleep, but dims it to save battery. Turn this off to keep the screen at full brightness the whole time (uses more battery).</string>
    <string name="use_aod_on">Always On Display: On</string>
    <string name="use_aod_off">Always On Display: Off</string>
    <string name="info_aod_body">While energy efficiency is on, this lets the watch\'s own Always On Display handle the dimmed screen instead of the app dimming it manually. Needs Always On Display enabled in the watch\'s system settings to take effect.</string>
    <string name="dim_brightness_title">Dim brightness</string>
    <string name="info_dim_brightness_body">How dim the screen gets during a session when energy efficiency is on and Always On Display isn\'t used.</string>

