    <string name="series_title">Série</string>
    <string name="history_series_size">%1$d/série</string>
    <string name="series_off">Desligado</string>
    <string name="info_series_body">Agrupa seus tiros em séries deste tamanho. O contador mostra o progresso na série atual e inicia uma nova automaticamente ao completá-la. Defina como "Desligado" para apenas contar tiros sem agrupamento.</string>
    <string name="auto_pause_title">Pausa automática</string>
    <string name="auto_pause_on">Pausa automática: Ativado</string>
    <string name="auto_pause_off">Pausa automática: Desativado</string>
    <string name="info_auto_pause_body">Pausa automaticamente a detecção de tiros por um tempo ao terminar uma série, para que ir até o alvo ou manusear flechas não seja contado como tiros. Retome antes a qualquer momento com o botão de pausa.</string>
    <string name="pause_duration_title">Duração da pausa</string>

    <string name="power_saving_title">Eficiência energética</string>
    <string name="power_saving_on">Eficiência energética: Ativado</string>
    <string name="power_saving_off">Eficiência energética: Desativado</string>
    <string name="info_power_saving_body">Mantém a tela ligada durante uma sessão em vez de deixá-la dormir, mas a escurece para economizar bateria. Desative para manter o brilho máximo o tempo todo (consome mais bateria).</string>
    <string name="use_aod_on">Always On Display: Ativado</string>
    <string name="use_aod_off">Always On Display: Desativado</string>
    <string name="info_aod_body">Enquanto a eficiência energética estiver ativada, isso deixa o próprio Always On Display do relógio cuidar da tela escurecida em vez do app escurecer manualmente. É preciso ativar o Always On Display nas configurações do sistema do relógio.</string>
    <string name="dim_brightness_title">Brilho reduzido</string>
    <string name="info_dim_brightness_body">O quão escura a tela fica durante uma sessão quando a eficiência energética está ativada e o Always On Display não está em uso.</string>

