    <string name="series_title">Serie</string>
    <string name="history_series_size">%1$d/serie</string>
    <string name="series_off">Apagado</string>
    <string name="info_series_body">Agrupa tus disparos en series de este tamaño. El contador muestra el progreso dentro de la serie actual y empieza una nueva automáticamente al completarse. Pon «Apagado» para solo contar disparos sin agrupar.</string>
    <string name="auto_pause_title">Pausa automática</string>
    <string name="auto_pause_on">Pausa automática: Activado</string>
    <string name="auto_pause_off">Pausa automática: Desactivado</string>
    <string name="info_auto_pause_body">Pausa automáticamente la detección de disparos un rato al terminar una serie, para que caminar hacia el blanco o manejar flechas no se cuente como disparos. Puedes reanudar antes con el botón de pausa.</string>
    <string name="pause_duration_title">Duración de pausa</string>

    <string name="power_saving_title">Eficiencia energética</string>
    <string name="power_saving_on">Eficiencia energética: Activado</string>
    <string name="power_saving_off">Eficiencia energética: Desactivado</string>
    <string name="info_power_saving_body">Mantiene la pantalla encendida durante una sesión en vez de dejarla dormir, pero la atenúa para ahorrar batería. Desactívalo para mantener el brillo máximo todo el tiempo (consume más batería).</string>
    <string name="use_aod_on">Always On Display: Activado</string>
    <string name="use_aod_off">Always On Display: Desactivado</string>
    <string name="info_aod_body">Mientras la eficiencia energética está activada, esto deja que el Always On Display propio del reloj controle la pantalla atenuada en lugar de que la app la atenúe manualmente. Necesita tener Always On Display activado en los ajustes del sistema del reloj.</string>
    <string name="dim_brightness_title">Brillo atenuado</string>
    <string name="info_dim_brightness_body">Qué tan tenue se pone la pantalla durante una sesión cuando la eficiencia energética está activada y no se usa Always On Display.</string>

